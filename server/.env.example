# Copy to server/.env and fill in. server/.env is git-ignored. NEVER put these in /client.

PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Google Firebase ----------
FIREBASE_PROJECT_ID=your-project-id
# Firebase console → Project settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# (or paste the whole JSON on one line, for hosting providers)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# firestore (real) | memory (tests only — data is lost on restart)
DATA_STORE=firestore

# Emails that become admins when they first complete onboarding (comma-separated)
ADMIN_EMAILS=

# Local testing with the Firebase Auth emulator (leave empty for real Firebase)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------- Microsoft Azure: AI (Stage 2) ----------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ---------- Microsoft Azure: Blob Storage (Stage 3) ----------
# Storage account → Security + networking → Access keys → Connection string
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=mindora-files
