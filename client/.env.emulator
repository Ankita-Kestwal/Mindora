# Used by `npm run dev` (local demo mode with the Firebase Auth emulator). No real accounts.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-mindora.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-mindora
VITE_FIREBASE_APP_ID=1:1:web:1
VITE_API_URL=http://localhost:4000/api
VITE_USE_AUTH_EMULATOR=true
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
